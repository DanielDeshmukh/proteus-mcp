{
  "name": "proteus-mcp",
  "version": "1.0.0",
  "description": "MCP server wrapping the PROTEUS resume-matching pipeline",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "proteus-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx src/test.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
