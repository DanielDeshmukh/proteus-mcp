{
  "name": "proteus-mcp",
  "version": "1.0.0",
  "description": "MCP server wrapping the PROTEUS resume-matching pipeline — deterministic scoring, gap analysis, rewrites, and cover letters",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "proteus-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "models.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx src/test.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "resume-matching",
    "jd-analysis",
    "nvidia-nim",
    "embeddings",
    "cosine-similarity",
    "deterministic-scoring",
    "ai-tools",
    "llm",
    "claude-desktop",
    "claude-code"
  ],
  "author": "Daniel Deshmukh",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
